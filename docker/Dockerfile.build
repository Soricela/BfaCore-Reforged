FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    git \
    python3 \
    python3-pip \
    libboost-all-dev \
    libssl-dev \
    default-libmysqlclient-dev \
    mysql-client \
    libreadline-dev \
    zlib1g-dev \
    libncurses5-dev \
    libncursesw5-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# El README de BfaCore recomienda CMake >= 3.20.
# Ubuntu 20.04 trae 3.16, así que instalamos una versión moderna
# pero todavía cercana temporalmente al proyecto.
RUN pip3 install --no-cache-dir cmake==3.22.6

RUN cmake --version \
    && gcc --version \
    && g++ --version \
    && openssl version

WORKDIR /src

COPY . /src

RUN mkdir -p /build /opt/bfacore

WORKDIR /build

RUN cmake /src \
    -DCMAKE_INSTALL_PREFIX=/opt/bfacore \
    -DCMAKE_BUILD_TYPE=RelWithDebInfo \
    -DSERVERS=1 \
    -DTOOLS=0 \
    -DSCRIPTS=static

RUN cmake --build . --target bnetserver worldserver -- -j16

RUN cmake --install .

CMD ["/bin/bash"]
